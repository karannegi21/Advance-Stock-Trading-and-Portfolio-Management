# Environment & Server
ENV=development
PORT=8000
HOST=0.0.0.0

# Database (PostgreSQL URL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stock_platform

# Security & JWT
JWT_SECRET=replace_with_a_secure_random_secret_key_minimum_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Market Simulator
SIMULATOR_SPEED_SECONDS=20
SIMULATOR_AUTO_START=true
